// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mongodb"
  url  	    = env("DATABASE_URL")
}

model Resume {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String

  // Basic Information
  title String?
  description String?
  firstName String?
  lastName String?
  jobTitle String?
  
  // Contact Information
  email String?
  phone String?
  city String?
  country String?
  website String?
  linkedin String?
  github String?
  
  // Appearance
  photoUrl String?
  colorHex String @default("#000000")
  borderStyle String @default("squircle")
  template String @default("CLASSIC")
  
  // Content
  summary String?
  jobDescription String?
  skills String[]
  certifications Certification[]
  languages String[]
  
  // Work & Education
  workExperiences WorkExperience[]
  educations Education[]
  
  // Payment & Status
  checkoutId String?
  paid Boolean @default(false)
  downloaded Boolean @default(false)
  downloadRequest Boolean @default(false)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

model WorkExperience {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  position String?
  company String?
  location String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_experiences")
}

model Education {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  degree String?
  school String?
  location String?
  fieldOfStudy String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model Certification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String?
  issuer String?
  date DateTime?
  credentialUrl String?
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certifications")
}

model Coupon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  discount    Float
  usageLimit  Int?
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("coupons")
}

model Template {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  image     String
  isPremium Boolean   @default(false)
  category  String?   // e.g., "ATS", "Creative", "Modern"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}