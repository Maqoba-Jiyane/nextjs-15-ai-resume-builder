// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mongodb"
  url  	    = env("DATABASE_URL")
}

model Resume {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String

  // Basic Information
  title String?
  description String?
  firstName String?
  lastName String?
  jobTitle String?
  
  // Contact Information
  email String?
  phone String?
  city String?
  country String?
  website String?
  linkedin String?
  github String?
  
  // Appearance
  photoUrl String?
  colorHex String @default("#000000")
  borderStyle String @default("squircle")
  template String @default("classic")
  
  // Content
  summary String?
  jobDescription String?
  skills String[]
  certifications Certification[]
  languages String[]
  
  // Work & Education
  workExperiences WorkExperience[]
  educations Education[]
  
  // Payment & Status
  checkoutId String?
  paid Boolean @default(false)
  downloaded Boolean @default(false)
  downloadRequest Boolean @default(false)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  Payment Payment[]
  

  @@map("resumes")
  @@index([userId, createdAt, updatedAt])
}

model WorkExperience {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  position String?
  company String?
  location String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_experiences")
}

model Education {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  degree String?
  school String?
  location String?
  fieldOfStudy String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model Certification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String?
  issuer String?
  date DateTime?
  credentialUrl String?
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certifications")
}

model Coupon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  discount    Float
  usageLimit  Int?
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("coupons")
}

model Template {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId String
  name      String
  image     String
  isPremium Boolean   @default(false)
  category  String?   // e.g., "ATS", "Creative", "Modern"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("template")
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique                     // Clerk user ID
  email            String?  @unique
  image            String?                              // Clerk profile picture

  // 🔹 Personal Details (editable by user)
  firstName        String?
  lastName         String?
  jobTitle         String?
  phone            String?
  city             String?
  country          String?
  website          String?
  linkedin         String?
  github           String?

  // 🔹 Resume Metadata (for autofill, smart features)
  summary          String?
  skills           String[]     // tags (e.g. JavaScript, UI Design)
  languages        String[]     // list of spoken languages

  // 🔹 Referral System
  referralCode     String?   @unique @default(uuid())     // each user gets a unique referral code
  referredByCode   String?                                // FK to another user’s referralCode
  referredBy       User?    @relation("Referrer", fields: [referredByCode], references: [referralCode], onDelete: NoAction, onUpdate: NoAction)
  referrals        User[]   @relation("Referrer")

  // 🔹 Relations
  resumes              Resume[]
  workExperiencePrompts WorkExperiencePrompt[]
  educations           UserEducation[]

  // 🔹 Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  affiliate        Boolean @default(false)

  @@map("user")
  @@index([referredByCode])
}


model WorkExperiencePrompt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?   // e.g., "Junior Frontend Developer"

  prompt  String? // Prompt description or instruction for AI

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional: link to User (if personalized prompts are allowed)
  userId   String?  
  user        User?    @relation(fields: [userId], references: [userId])
  
  @@map("work_experience_prompt")
}

model UserEducation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  degree String?
  school String?
  location String?
  fieldOfStudy String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)

  userId   String?  
  user        User?    @relation(fields: [userId], references: [userId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_educations")
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  checkoutId  String   @unique
  userId      String
  resumeId    String
  referralCode  String?
  resume      Resume   @relation(fields: [resumeId], references: [id])
  amountPaid  Float
  paidAt      DateTime

  @@map("resume_payments")
}

model Referral {
  id           String   @id @default(uuid()) @map("_id")
  referrerId   String
  referredId   String?
  createdAt    DateTime @default(now())
  type         String   // "click", "signup", "conversion"
  
  @@map("referrals")
}
