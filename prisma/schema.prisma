// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mongodb"
  url  	    = env("DATABASE_URL")
}

model Resume {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // FK to *internal* User id
  userId String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Information
  title String?
  description String?
  firstName String?
  lastName String?
  jobTitle String?
  
  // Contact Information
  email String?
  phone String?
  city String?
  country String?
  website String?
  linkedin String?
  github String?
  
  // Appearance
  photoUrl String?
  colorHex String @default("#000000")
  borderStyle String @default("squircle")
  template String @default("classic")
  
  // Content
  summary String?
  jobDescription String?
  skills String[]
  certifications Certification[]
  
  // Work & Education
  workExperiences WorkExperience[]
  educations Education[]
  
  // Payment & Status
  checkoutId String?
  paid Boolean @default(false)
  downloaded Boolean @default(false)
  downloadRequest Boolean @default(false)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Payment Payment[]

  
  languages   Language[]
  references  Reference[]
  

  @@map("resumes")
  @@index([userId, createdAt, updatedAt])
}

model WorkExperience {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  position String?
  company String?
  location String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_experiences")
}

model Education {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  degree String?
  school String?
  location String?
  fieldOfStudy String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model Certification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String?
  issuer String?
  date DateTime?
  credentialUrl String?
  
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certifications")
}

model Coupon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  discount    Float
  usageLimit  Int?
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("coupons")
}

model Template {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId String
  name      String
  image     String
  isPremium Boolean   @default(false)
  category  String?   // e.g., "ATS", "Creative", "Modern"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("template")
}

enum Plan {
  FREE
  PREMIUM
}

enum BillingCycle {
  WEEKLY
  MONTHLY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique                     // Clerk user ID
  email            String?  @unique
  image            String?                              // Clerk profile picture
  
  plan          Plan     @default(FREE)
  premiumUntil  DateTime?   // if now < premiumUntil => Premium

  affiliate Affiliate?
  

  // 🔹 Personal Details (editable by user)
  firstName        String?
  lastName         String?
  jobTitle         String?
  phone            String?
  city             String?
  country          String?
  website          String?
  linkedin         String?
  github           String?

  // 🔹 Resume Metadata (for autofill, smart features)
  summary          String?
  skills           String[]     // tags (e.g. JavaScript, UI Design)
  languages        String[]     // list of spoken languages

  // 🔹 Referral System
  referralCode     String?   @unique @default(uuid())     // each user gets a unique referral code
  referredByCode   String?                                // FK to another user’s referralCode
  referredBy       User?    @relation("Referrer", fields: [referredByCode], references: [referralCode], onDelete: NoAction, onUpdate: NoAction)
  referrals        User[]   @relation("Referrer")
  
  // relations
  resumes       Resume[]
  payments      Payment[]
  workExperiencePrompts WorkExperiencePrompt[]
  educations           UserEducation[]

  // 🔹 Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user")
  @@index([referredByCode])
}

model Affiliate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [userId])

  code            String   @unique           // e.g. "EON-4F7KQ"
  status          String   @default("active") // "active" | "paused" | "banned"

  payshapId       String
  bank            String

  totalClicks     Int      @default(0)
  totalSignups    Int      @default(0)
  totalPurchases  Int      @default(0)   // cents
  totalCommission Int      @default(0)   // cents

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WorkExperiencePrompt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?   // e.g., "Junior Frontend Developer"

  prompt  String? // Prompt description or instruction for AI

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional: link to User (if personalized prompts are allowed)
  userId   String?  
  user        User?    @relation(fields: [userId], references: [userId])
  
  @@map("work_experience_prompt")
}

model UserEducation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  degree String?
  school String?
  location String?
  fieldOfStudy String?
  startDate DateTime?
  endDate DateTime?
  description String?
  isCurrent Boolean @default(false)

  userId   String?  
  user        User?    @relation(fields: [userId], references: [userId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_educations")
}

// One-off payment records for audit/reconciliation
model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  provider        String        @default("YOCO")     // fixed for now
  checkoutId      String?        @unique              // Yoco checkout id
  reference       String?                             // "plan=premium&cycle=MONTHLY&resumeId=..."

  // FK to *internal* User id
  userId          String        
  user            User          @relation(fields: [userId], references: [userId])

  resumeId        String?       @db.ObjectId
  resume          Resume?       @relation(fields: [resumeId], references: [id])

  cycle           BillingCycle
  plan            Plan
  currency        String        @default("ZAR")
  subtotalCents   Int
  discountCents   Int           @default(0)
  taxCents        Int           @default(0)
  totalCents      Int

  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  
  referralCode  String?
  amountPaid  Float?

  requestPayload  Json?
  responsePayload Json?
  webhookPayload  Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([paidAt])
}

model Referral {
  id           String   @id @default(uuid()) @map("_id")
  referrerId   String
  referredId   String?
  createdAt    DateTime @default(now())
  type         String   // "click", "signup", "conversion"
  
  @@map("referrals")
}

model WebhookEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @unique // "webhook-id" from Yoco
  createdAt DateTime @default(now())
}

enum LanguageLevel {
  NATIVE
  FLUENT
  ADVANCED
  INTERMEDIATE
  BASIC
}

model Language {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  resumeId  String        @db.ObjectId
  name      String?
  level     String?

  resume    Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Reference {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  resumeId   String   @db.ObjectId
  name       String?
  role       String?  // e.g., "CTO"
  company    String?
  phone      String?
  email      String?
  note       String?  // optional blurb

  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}